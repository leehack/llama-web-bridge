{
  "name": "llama-web-bridge",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.2.0"
  },
  "scripts": {
    "build:js": "node scripts/build/build_js_bridge.mjs",
    "check:js": "npm run typecheck:js && npm run build:js && npm run syntax:js && npm test",
    "syntax:js": "node --check js/llama_webgpu_bridge.js && node --check js/llama_webgpu_bridge_worker.js",
    "test": "node --test 'tests/**/*_test.mjs'",
    "typecheck:js": "tsc -p tsconfig.bridge.json --noEmit && tsc -p tsconfig.strict.json --noEmit"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "yaml": "2.8.4"
  }
}
