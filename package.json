{
  "name": "llama-web-bridge",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "scripts": {
    "build:js": "node scripts/build_js_bridge.mjs",
    "check:js": "npm run typecheck:js && npm run build:js && npm run syntax:js && npm run test:embedding-json && npm run test:operation-queue && npm run test:operation-lifecycle && npm run test:tts-recovery && npm run test:worker-state && npm run test:worker-token-coalescing",
    "syntax:js": "node --check js/llama_webgpu_bridge.js && node --check js/llama_webgpu_bridge_worker.js",
    "test:embedding-json": "node scripts/embedding_json_contract_test.mjs",
    "test:operation-queue": "node scripts/bridge_operation_queue_test.mjs",
    "test:operation-lifecycle": "node scripts/bridge_operation_lifecycle_test.mjs",
    "test:tts-recovery": "node scripts/text_to_speech_recovery_test.mjs",
    "test:worker-state": "node scripts/worker_runtime_state_test.mjs",
    "test:worker-token-coalescing": "node scripts/worker_token_coalescing_test.mjs",
    "typecheck:js": "tsc -p tsconfig.bridge.json --noEmit"
  },
  "devDependencies": {
    "esbuild": "0.27.7",
    "typescript": "5.9.3",
    "yaml": "2.8.1"
  }
}
