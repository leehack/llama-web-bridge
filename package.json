{
  "name": "llama-web-bridge",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build:js": "node scripts/build_js_bridge.mjs",
